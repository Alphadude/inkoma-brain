# ─────────────────────────────────────────────
#  Server
# ─────────────────────────────────────────────
PORT=5000
NODE_ENV=development          # development | production

# ─────────────────────────────────────────────
#  Database
# ─────────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/boilerplate_db
# For Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/<dbname>?retryWrites=true&w=majority

# ─────────────────────────────────────────────
#  Authentication
# ─────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret_string_min_32_chars
JWT_EXPIRES_IN=7d             # e.g. 15m | 1h | 7d

# ─────────────────────────────────────────────
#  Security
# ─────────────────────────────────────────────
BCRYPT_ROUNDS=12              # Higher = slower hash (recommended: 10-14)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ─────────────────────────────────────────────
#  Cloudinary
# ─────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# ─────────────────────────────────────────────
#  Brevo (Email & SMS)
# ─────────────────────────────────────────────
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your_login@smtp-brevo.com
BREVO_SMTP_KEY=your_smtp_key
BREVO_SENDER_EMAIL=your_verified_sender@domain.com
BREVO_SENDER_NAME=Inkoma

# Brevo API Key for SMS (v3 API key starting with xkeysib-)
BREVO_API_KEY=your_brevo_api_key
BREVO_SMS_SENDER=Inkoma
